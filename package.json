{
  "name": "the-oven-fresh-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "worker:build": "tsc --project tsconfig.worker.json",
    "worker": "npm run worker:build && node .worker-build/worker/index.js",
    "meta:webhook-proxy": "node scripts/meta-webhook-proxy.mjs",
    "meta:subscribe-webhook": "node --env-file=.env scripts/meta-subscribe-webhook.mjs",
    "bootstrap:admin": "node --env-file=.env scripts/bootstrap-admin.mjs",
    "reset:admin": "node --env-file=.env scripts/bootstrap-admin.mjs --reset"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@xmldom/xmldom": "^0.9.12",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "^5.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
