NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
STAFF_ADMIN_EMAILS=admin@company.com

# Meta WhatsApp Cloud API (server-only; use the version enabled for your app)
META_GRAPH_API_VERSION=vXX.X
META_APP_ID=your-meta-app-id
META_WABA_ID=your-whatsapp-business-account-id
META_PHONE_NUMBER_ID=your-phone-number-id
# This token must belong to META_APP_ID and include whatsapp_business_management
# for WABA webhook subscription, plus the permissions needed by your other Meta calls.
META_SYSTEM_USER_ACCESS_TOKEN=your-system-user-token
META_APP_SECRET=your-meta-app-secret
# Use this same value when registering your public HTTPS callback in the Meta App dashboard.
META_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
# Comma-separated quick-reply payloads that mean opt-out in approved templates.
META_OPT_OUT_BUTTON_PAYLOADS=
# A number you control and have agreed to use for one-off template tests.
META_TEST_RECIPIENT_E164=+15555550123

# The persistent worker refuses to send until enabled and every send window field is set.
WHATSAPP_SENDS_ENABLED=false
WHATSAPP_SEND_TIME_ZONE=
WHATSAPP_SEND_WINDOW_START=
WHATSAPP_SEND_WINDOW_END=
WHATSAPP_SEND_DAYS=
# Internal list mode: imported numbers become campaign-eligible automatically (opt-outs still win).
CONTACT_IMPORT_AUTO_ENABLE=true
